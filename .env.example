# Obligatoria: clave del proveedor LLM (solo en el backend; nunca en el repo ni en el front)
ANTHROPIC_API_KEY=

# Opcionales (valores por defecto entre paréntesis)
# LLM_MODEL=claude-sonnet-5-5
# LLM_EFFORT=medium            # low | medium | high | xhigh | max
# LLM_TIMEOUT_MS=90000
# LLM_MAX_TOKENS=16000         # tope de tokens de salida por respuesta
# MAX_ITERACIONES=25           # tope de ciclos herramienta → modelo por turno
# MAX_TOKENS_SESION=200000     # tope de tokens por sesión
# MAX_SESIONES=200
# ACCESS_KEY=                  # si se define, la API exige el header x-access-key
# PORT=3000
